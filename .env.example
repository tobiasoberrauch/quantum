# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# qvc_discovery.py loads this via python-dotenv at import time.

# Required for `discover` (real LLM calls). Leave empty to run score/verify only.
OPENROUTER_API_KEY=

# Optional model overrides (defaults are set in qvc_discovery.py).
# QVC_SONNET=anthropic/claude-sonnet-4.6
# QVC_GPT4=openai/gpt-4
# QVC_DEEPSEEK=deepseek/deepseek-r1-0528
# QVC_QWEN=qwen/qwen3-235b-a22b-2507

# --- Team tab (qvc_web): local model + FreeToken (FlashML) presets ---
# Local Qwen endpoint override (defaults shown):
# QVC_LOCAL_BASE_URL=http://192.168.212.81:8000/v1
# QVC_LOCAL_MODEL=qwen3.8-27b
# FreeToken: point at a GPU host running `ft serve` (OpenAI-compatible, keyless).
# FREETOKEN_BASE_URL=http://<gpu-host>:1919/v1
# FREETOKEN_MODEL=Qwen3.6-35B-A3B
# Ollama (Apple Silicon / local, OpenAI-compatible at :11434/v1, keyless):
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3.5:27b
